{% extends 'base.html.twig' %}

{% block title %}{{ 'panier.titre'|trans }}{% endblock %}

{% block body %}
    <h1 class="mb-4">{{ 'panier.titre'|trans }}</h1>

    {% if panier and panier.contenus is not empty %}
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="carte table-carte">
                    {% include '_tableau_panier.html.twig' with {panier: panier, avec_suppression: true} %}
                </div>
            </div>

            <div class="col-lg-4">
                <div class="carte carte-corps recapitulatif">
                    <h2 class="h4 mb-3">{{ 'panier.recapitulatif'|trans }}</h2>
                    {% for ligne in panier.contenus %}
                        <div class="ligne">
                            <span>{{ ligne.produit.nom }} × {{ ligne.quantite }}</span>
                            <span>{{ ligne.montant|number_format(2, ',', ' ') ~ ' €' }}</span>
                        </div>
                    {% endfor %}
                    <div class="ligne total">
                        <span>{{ 'tableau.total'|trans }}</span>
                        <span>{{ panier.total|number_format(2, ',', ' ') ~ ' €' }}</span>
                    </div>

                    <form method="post" action="{{ path('app_panier_acheter') }}" class="mt-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('acheter_panier') }}">
                        <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-credit-card"></i> {{ 'bouton.acheter'|trans }}</button>
                    </form>
                    <p class="text-muted small text-center mt-3 mb-0"><i class="bi bi-lock"></i> {{ 'panier.paiement_fictif'|trans }}</p>
                </div>
            </div>
        </div>
    {% else %}
        <div class="carte etat-vide">
            <div class="icone"><i class="bi bi-bag"></i></div>
            <p>{{ 'panier.vide'|trans }}</p>
            <a href="{{ path('app_accueil') }}" class="btn btn-primary">{{ 'bouton.voir_produits'|trans }} <i class="bi bi-arrow-right"></i></a>
        </div>
    {% endif %}
{% endblock %}
