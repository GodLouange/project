<div class="photo-produit" style="--hauteur: {{ hauteur }}px">
    {% if produit.photo %}
        <img src="{{ asset('uploads/produits/' ~ produit.photo) }}" alt="{{ produit.nom }}" loading="lazy">
    {% else %}
        <div class="photo-vide">
            <i class="bi bi-image"></i>
            {{ 'produit.sans_photo'|trans }}
        </div>
    {% endif %}

    {% if avec_stock ?? false %}
        {% if produit.stock > 0 %}
            <span class="stock ok">{{ 'produit.en_stock'|trans({'%stock%': produit.stock}) }}</span>
        {% else %}
            <span class="stock ko">{{ 'produit.rupture'|trans }}</span>
        {% endif %}
    {% endif %}
</div>
