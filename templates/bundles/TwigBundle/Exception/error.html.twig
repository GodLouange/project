{#
    Page d'erreur personnalisée générique (500 et tous les codes sans page dédiée).
    Placée dans templates/bundles/TwigBundle/Exception pour remplacer la page par défaut de Symfony.
    Les pages 403 et 404 en héritent et ne changent que les blocs "titre" et "message".
    En mode dev, on peut la tester avec /_error/500.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'erreur.titre'|trans({'%code%': status_code}) }}{% endblock %}

{% block body %}
    <div class="page-erreur">
        <p class="code">{% block code %}{{ status_code }}{% endblock %}</p>
        <h1 class="h2 mb-3">{% block titre %}{{ 'erreur.generique.titre'|trans }}{% endblock %}</h1>
        <p class="text-muted mb-4">{% block message %}{{ 'erreur.generique.message'|trans }}{% endblock %}</p>
        <a href="{{ path('app_accueil') }}" class="btn btn-primary btn-lg"><i class="bi bi-house"></i> {{ 'bouton.retour_accueil'|trans }}</a>
    </div>
{% endblock %}
