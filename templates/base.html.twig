<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'site.nom'|trans }}{% endblock %} | {{ 'site.nom'|trans }}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🛒</text></svg>">

        {% block stylesheets %}
            {# Bootstrap 5 (CSS uniquement) pour la mise en page #}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">

        {# ===== Menu : les liens affichés dépendent du rôle de l'internaute ===== #}
        <nav class="navbar navbar-expand bg-dark navbar-dark mb-4">
            <div class="container flex-wrap gap-2">
                <a class="navbar-brand" href="{{ path('app_accueil') }}">🛒 {{ 'site.nom'|trans }}</a>

                <ul class="navbar-nav me-auto flex-wrap">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_accueil') }}">{{ 'menu.accueil'|trans }}</a></li>

                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_panier') }}">{{ 'menu.panier'|trans }}</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_compte') }}">{{ 'menu.compte'|trans }}</a></li>
                    {% endif %}

                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                        <li class="nav-item"><a class="nav-link text-warning" href="{{ path('app_super_admin_paniers') }}">{{ 'menu.super_admin.paniers'|trans }}</a></li>
                        <li class="nav-item"><a class="nav-link text-warning" href="{{ path('app_super_admin_utilisateurs') }}">{{ 'menu.super_admin.utilisateurs'|trans }}</a></li>
                    {% endif %}
                </ul>

                <ul class="navbar-nav align-items-center flex-wrap">
                    {% if app.user %}
                        <li class="nav-item navbar-text me-2">
                            {{ 'menu.bonjour'|trans({'%prenom%': app.user.prenom}) }}
                            {% if is_granted('ROLE_SUPER_ADMIN') %}
                                <span class="badge text-bg-warning">SUPER ADMIN</span>
                            {% elseif is_granted('ROLE_ADMIN') %}
                                <span class="badge text-bg-info">ADMIN</span>
                            {% endif %}
                        </li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_deconnexion') }}">{{ 'menu.deconnexion'|trans }}</a></li>
                    {% else %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_connexion') }}">{{ 'menu.connexion'|trans }}</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_inscription') }}">{{ 'menu.inscription'|trans }}</a></li>
                    {% endif %}

                    {# Choix de la langue #}
                    <li class="nav-item ms-2">
                        <a class="btn btn-sm {{ app.request.locale == 'fr' ? 'btn-light' : 'btn-outline-light' }}" href="{{ path('app_langue', {locale: 'fr'}) }}">FR</a>
                        <a class="btn btn-sm {{ app.request.locale == 'en' ? 'btn-light' : 'btn-outline-light' }}" href="{{ path('app_langue', {locale: 'en'}) }}">EN</a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="container flex-grow-1">
            {# ===== Messages flash (succès / échec des actions) ===== #}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}" role="alert">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="bg-light text-center text-muted py-3 mt-5">
            {{ 'site.pied_de_page'|trans({'%annee%': 'now'|date('Y')}) }}
        </footer>
    </body>
</html>
