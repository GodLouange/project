<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'site.nom'|trans }}{% endblock %} | {{ 'site.nom'|trans }}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2230%22 fill=%22%231d1b18%22/><text x=%2264%22 y=%2290%22 font-size=%2272%22 text-anchor=%22middle%22 fill=%22%23faf7f2%22 font-family=%22Georgia%22>B</text></svg>">

        {% block stylesheets %}
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        {% set route = app.request.attributes.get('_route') %}

        <header class="site-header sticky-top">
            <nav class="navbar navbar-expand">
                <div class="container flex-wrap gap-3">
                    <a class="marque" href="{{ path('app_accueil') }}">
                        <span class="marque-logo"><i class="bi bi-bag-heart"></i></span>
                        {{ 'site.nom'|trans }}
                    </a>

                    <ul class="navbar-nav nav-principale me-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link {{ route == 'app_accueil' ? 'active' }}" href="{{ path('app_accueil') }}">
                                <i class="bi bi-grid"></i> {{ 'menu.accueil'|trans }}
                            </a>
                        </li>
                        {% if is_granted('ROLE_USER') %}
                            <li class="nav-item">
                                <a class="nav-link {{ route == 'app_panier' ? 'active' }}" href="{{ path('app_panier') }}">
                                    <i class="bi bi-bag"></i> {{ 'menu.panier'|trans }}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {{ route starts with 'app_compte' ? 'active' }}" href="{{ path('app_compte') }}">
                                    <i class="bi bi-person"></i> {{ 'menu.compte'|trans }}
                                </a>
                            </li>
                        {% endif %}
                    </ul>

                    <div class="d-flex align-items-center flex-wrap gap-3">
                        {% if app.user %}
                            <span class="puce-utilisateur">
                                <span class="avatar">{{ app.user.prenom|first }}</span>
                                <span class="nom">{{ 'menu.bonjour'|trans({'%prenom%': app.user.prenom}) }}</span>
                                {% if is_granted('ROLE_SUPER_ADMIN') %}
                                    <span class="badge-role super">SUPER ADMIN</span>
                                {% elseif is_granted('ROLE_ADMIN') %}
                                    <span class="badge-role admin">ADMIN</span>
                                {% endif %}
                            </span>
                            <a class="btn btn-icone btn-outline-dark" href="{{ path('app_deconnexion') }}"
                               title="{{ 'menu.deconnexion'|trans }}" aria-label="{{ 'menu.deconnexion'|trans }}">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        {% else %}
                            <a class="btn btn-sm btn-outline-dark" href="{{ path('app_connexion') }}">{{ 'menu.connexion'|trans }}</a>
                            <a class="btn btn-sm btn-dark" href="{{ path('app_inscription') }}">{{ 'menu.inscription'|trans }}</a>
                        {% endif %}

                        <div class="choix-langue" role="group" aria-label="Langue / Language">
                            <a class="{{ app.request.locale == 'fr' ? 'actif' }}" href="{{ path('app_langue', {locale: 'fr'}) }}">FR</a>
                            <a class="{{ app.request.locale == 'en' ? 'actif' }}" href="{{ path('app_langue', {locale: 'en'}) }}">EN</a>
                        </div>
                    </div>
                </div>
            </nav>

            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <div class="barre-admin">
                    <div class="container">
                        <span class="etiquette"><i class="bi bi-shield-lock"></i> Super admin</span>
                        <a class="{{ route == 'app_super_admin_paniers' ? 'active' }}" href="{{ path('app_super_admin_paniers') }}">
                            <i class="bi bi-cart3"></i> {{ 'menu.super_admin.paniers'|trans }}
                        </a>
                        <a class="{{ route == 'app_super_admin_utilisateurs' ? 'active' }}" href="{{ path('app_super_admin_utilisateurs') }}">
                            <i class="bi bi-people"></i> {{ 'menu.super_admin.utilisateurs'|trans }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </header>

        <main class="container contenu-principal flex-grow-1">
            {% set icones_flash = {success: 'check-circle-fill', danger: 'exclamation-octagon-fill', warning: 'exclamation-triangle-fill', info: 'info-circle-fill'} %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }} mb-4" role="alert">
                        <i class="bi bi-{{ icones_flash[type] ?? 'info-circle-fill' }}"></i>
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer mt-auto">
            <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
                <a class="marque" href="{{ path('app_accueil') }}">
                    <span class="marque-logo"><i class="bi bi-bag-heart"></i></span>
                    {{ 'site.nom'|trans }}
                </a>
                <span>{{ 'site.pied_de_page'|trans({'%annee%': 'now'|date('Y')}) }}</span>
            </div>
        </footer>
    </body>
</html>
