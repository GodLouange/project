{% extends 'base.html.twig' %}

{% block title %}{{ 'connexion.titre'|trans }}{% endblock %}

{% block body %}
    <div class="carte carte-corps carte-auth">
        <div class="entete">
            <div class="icone-ronde"><i class="bi bi-person-circle"></i></div>
            <h1>{{ 'connexion.titre'|trans }}</h1>
        </div>

        {% if erreur %}
            <div class="alert alert-danger"><i class="bi bi-exclamation-octagon-fill"></i> <span>{{ erreur.messageKey|trans(erreur.messageData, 'security') }}</span></div>
        {% endif %}

        <form method="post" action="{{ path('app_connexion') }}">
            <div class="mb-3">
                <label for="username" class="form-label">{{ 'form.email'|trans }}</label>
                <input type="email" value="{{ dernier_email }}" name="_username" id="username"
                       class="form-control" autocomplete="email" required autofocus>
            </div>
            <div class="mb-4">
                <label for="password" class="form-label">{{ 'form.mot_de_passe'|trans }}</label>
                <input type="password" name="_password" id="password"
                       class="form-control" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-primary btn-lg w-100" type="submit">{{ 'bouton.se_connecter'|trans }}</button>
        </form>

        <p class="separateur mb-0">
            {{ 'connexion.pas_de_compte'|trans }}
            <a href="{{ path('app_inscription') }}">{{ 'menu.inscription'|trans }}</a>
        </p>
    </div>
{% endblock %}
