{% extends 'base.html.twig' %}

{% block title %}{{ 'inscription.titre'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h1 class="mb-4">{{ 'inscription.titre'|trans }}</h1>

            {{ form_start(form) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn btn-primary w-100">{{ 'bouton.inscrire'|trans }}</button>
            {{ form_end(form) }}

            <p class="mt-3 text-center">
                {{ 'inscription.deja_inscrit'|trans }}
                <a href="{{ path('app_connexion') }}">{{ 'menu.connexion'|trans }}</a>
            </p>
        </div>
    </div>
{% endblock %}
