{# Modification d'un produit (ADMIN) : même formulaire que l'ajout (ProduitType) #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'produit.modifier'|trans }}{% endblock %}

{% block body %}
    <a href="{{ path('app_produit_fiche', {id: produit.id}) }}" class="lien-retour"><i class="bi bi-arrow-left"></i> {{ 'bouton.retour'|trans }}</a>

    <h1 class="mb-4">{{ 'produit.modifier'|trans }}</h1>

    <div class="row g-4">
        {# Formulaire : la photo n'est remplacée que si un nouveau fichier est envoyé #}
        <div class="col-lg-8">
            <div class="carte carte-corps">
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> {{ 'bouton.enregistrer'|trans }}</button>
                {{ form_end(form) }}
            </div>
        </div>

        {# Aperçu de la photo actuelle #}
        <div class="col-lg-4">
            <div class="carte overflow-hidden">
                {% include '_photo_produit.html.twig' with {produit: produit, hauteur: 240} %}
                <div class="p-3 fw-semibold">{{ 'produit.photo_actuelle'|trans }}</div>
            </div>
        </div>
    </div>
{% endblock %}
