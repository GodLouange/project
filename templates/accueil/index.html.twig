{% extends 'base.html.twig' %}

{% block title %}{{ 'accueil.titre'|trans }}{% endblock %}

{% block body %}
    <section class="hero">
        <h1>{{ 'accueil.hero.titre'|trans }}</h1>
        <p>{{ 'accueil.hero.texte'|trans }}</p>
        <a href="#produits" class="btn btn-light btn-lg">{{ 'bouton.voir_produits'|trans }} <i class="bi bi-arrow-down"></i></a>
    </section>

    {% if form %}
        <details class="carte panneau-admin" {{ form.vars.submitted ? 'open' }}>
            <summary>
                <span class="icone-ronde"><i class="bi bi-plus-lg"></i></span>
                {{ 'produit.ajouter'|trans }}
                <i class="bi bi-chevron-down"></i>
            </summary>
            <div class="carte-corps">
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> {{ 'bouton.ajouter'|trans }}</button>
                {{ form_end(form) }}
            </div>
        </details>
    {% endif %}

    <div class="titre-section" id="produits">
        <h2 class="h1">{{ 'accueil.titre'|trans }}</h2>
        {% if produits is not empty %}
            <span class="compteur">{{ 'accueil.nb_produits'|trans({'%count%': produits|length}) }}</span>
        {% endif %}
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        {% for produit in produits %}
            <div class="col">
                <a href="{{ path('app_produit_fiche', {id: produit.id}) }}" class="carte-produit">
                    {% include '_photo_produit.html.twig' with {produit: produit, hauteur: 240, avec_stock: true} %}
                    <div class="carte-produit-corps">
                        <h3 class="carte-produit-nom">{{ produit.nom }}</h3>
                        <div class="carte-produit-pied">
                            <span class="prix">{{ produit.prix|number_format(2, ',', ' ') ~ ' €' }}</span>
                            <span class="voir-plus">{{ 'bouton.voir'|trans }} <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </div>
                </a>
            </div>
        {% else %}
            <div class="col-12">
                <div class="carte etat-vide">
                    <div class="icone"><i class="bi bi-box-seam"></i></div>
                    <p class="mb-0">{{ 'accueil.aucun_produit'|trans }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
